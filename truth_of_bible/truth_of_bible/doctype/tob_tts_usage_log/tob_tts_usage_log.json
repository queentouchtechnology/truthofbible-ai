{
 "doctype": "DocType",
 "name": "TOB TTS Usage Log",
 "module": "Truth Of Bible",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "quick_entry": 0,
 "track_changes": 0,
 "autoname": "hash",
 "naming_rule": "Random",
 "sort_field": "creation",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "description": "Append-only observability log — one row per synthesize call, mirroring TOB AI Usage Log's own shape with characters instead of tokens. Pure logging, no credit/billing deduction happens against this. was_cache_hit rows always carry estimated_cost_usd = 0 so usage reports distinguish 'served from cache' from 'newly paid for'.",
 "field_order": [
  "user",
  "task",
  "language",
  "column_break_provider",
  "provider",
  "voice_type",
  "was_cache_hit",
  "section_break_usage",
  "character_count",
  "estimated_cost_usd",
  "column_break_status",
  "status",
  "duration_ms",
  "error_message"
 ],
 "fields": [
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "task",
   "fieldtype": "Data",
   "label": "Task",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "e.g. bible_verse, ai_article, blog, lesson."
  },
  {
   "fieldname": "language",
   "fieldtype": "Link",
   "label": "Language",
   "options": "Language",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_provider",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "provider",
   "fieldtype": "Data",
   "label": "Provider",
   "in_list_view": 1
  },
  {
   "fieldname": "voice_type",
   "fieldtype": "Data",
   "label": "Voice Type"
  },
  {
   "fieldname": "was_cache_hit",
   "fieldtype": "Check",
   "label": "Was Cache Hit",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_usage",
   "fieldtype": "Section Break",
   "label": "Characters & Cost"
  },
  {
   "fieldname": "character_count",
   "fieldtype": "Int",
   "label": "Character Count"
  },
  {
   "fieldname": "estimated_cost_usd",
   "fieldtype": "Currency",
   "label": "Estimated Cost (USD)"
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "success\nerror",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "duration_ms",
   "fieldtype": "Int",
   "label": "Duration (ms)"
  },
  {
   "fieldname": "error_message",
   "fieldtype": "Small Text",
   "label": "Error Message"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "links": []
}
