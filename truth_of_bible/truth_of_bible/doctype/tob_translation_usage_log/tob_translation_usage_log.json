{
 "doctype": "DocType",
 "name": "TOB Translation Usage Log",
 "module": "Truth Of Bible",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "quick_entry": 0,
 "track_changes": 0,
 "autoname": "hash",
 "naming_rule": "Random",
 "sort_field": "creation",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "description": "Append-only observability log — one row per translate_now/translate_local_text/translate_field call, mirroring TOB TTS Usage Log's own shape. Pure logging, no credit/billing deduction happens against this. TOB Content Translation (the cache itself) has no per-request user field and can't attribute repeat generations to the right user, so this exists specifically to make per-user/per-day usage countable and to give translation an admin usage view, same as TTS already has via TOB TTS Usage Log.",
 "field_order": [
  "user",
  "source_doctype",
  "source_name",
  "field",
  "language",
  "column_break_status",
  "was_cache_hit",
  "status",
  "error_message"
 ],
 "fields": [
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "source_doctype",
   "fieldtype": "Data",
   "label": "Source Doctype",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Source Name"
  },
  {
   "fieldname": "field",
   "fieldtype": "Data",
   "label": "Field",
   "in_list_view": 1
  },
  {
   "fieldname": "language",
   "fieldtype": "Link",
   "label": "Language",
   "options": "Language",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "was_cache_hit",
   "fieldtype": "Check",
   "label": "Was Cache Hit",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "success\nerror",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "error_message",
   "fieldtype": "Small Text",
   "label": "Error Message"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "links": []
}
