 "engine": "InnoDB",
 "description": "One row per user — per-category notification toggles, daily reminder time, quiet hours and a daily cap. Created lazily (get-or-create) by the notification engine/whitelisted preference API the first time it's needed, always with sensible gentle-opt-out defaults, so a user who has never opened a settings screen still gets a reasonable, non-spammy experience. Category granularity intentionally matches TOB Notification Template.category (one toggle per routing category) — a future event needing a finer per-event toggle can add one more Check field without a schema break.",
 "field_order": [
  "user",
  "column_break_1",
  "timezone",
  "section_break_categories",
  "bible_reading",
  "spiritual_growth",
  "bible_study",
