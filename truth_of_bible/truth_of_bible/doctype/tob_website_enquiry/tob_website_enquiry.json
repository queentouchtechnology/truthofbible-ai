{
 "doctype": "DocType",
 "name": "TOB Website Enquiry",
 "module": "Truth Of Bible",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "quick_entry": 0,
 "track_changes": 1,
 "autoname": "format:ENQ-{YYYY}-{#####}",
 "naming_rule": "Expression",
 "sort_field": "creation",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "title_field": "full_name",
 "description": "A message sent from the contact / prayer request form on truthofbible.org. Saved before it is emailed, so nothing is lost if mail fails.",
 "field_order": [
  "full_name",
  "email",
  "phone",
  "country",
  "column_break_1",
  "topic",
  "status",
  "email_sent",
  "section_message",
  "message",
  "section_meta",
  "page",
  "ip_address",
  "column_break_2",
  "user_agent",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "full_name",
   "fieldtype": "Data",
   "label": "Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone / WhatsApp"
  },
  {
   "fieldname": "country",
   "fieldtype": "Data",
   "label": "Country"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "topic",
   "fieldtype": "Select",
   "label": "Topic",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Prayer request\nBible study guidance\nCounselling\nMinistry & events\nThe app\nOther",
   "default": "Prayer request"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "New\nIn progress\nReplied\nClosed\nSpam",
   "default": "New",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "email_sent",
   "fieldtype": "Check",
   "label": "Emailed to Team",
   "read_only": 1
  },
  {
   "fieldname": "section_message",
   "fieldtype": "Section Break",
   "label": "Message"
  },
  {
   "fieldname": "message",
   "fieldtype": "Long Text",
   "label": "Message",
   "reqd": 1
  },
  {
   "fieldname": "section_meta",
   "fieldtype": "Section Break",
   "label": "Details",
   "collapsible": 1
  },
  {
   "fieldname": "page",
   "fieldtype": "Data",
   "label": "Sent From Page",
   "read_only": 1
  },
  {
   "fieldname": "ip_address",
   "fieldtype": "Data",
   "label": "IP Address",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "user_agent",
   "fieldtype": "Small Text",
   "label": "Browser",
   "read_only": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Team Notes"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "links": []
}